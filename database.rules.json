{
  "rules": {
    "stats": {
      "parties": {
        ".read": true,
        ".write": "auth != null",
        ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
      }
    },
    "salons": {
      "$code": {
        ".write": "auth != null && $code.matches(/^[A-Z]{4}$/) && data.child('infos/hote').val() === auth.uid",
        "infos": {
          ".read": "auth != null",
          ".write": "auth != null && $code.matches(/^[A-Z]{4}$/) && (!data.exists() || data.child('creeLe').val() < now - 43200000 || data.child('hote').val() === auth.uid)",
          ".validate": "newData.hasChildren(['hote', 'duree', 'modeChoix', 'creeLe'])",
          "hote": {
            ".write": "auth != null && newData.val() === auth.uid && root.child('salons/' + $code + '/joueurs/' + auth.uid + '/connecte').val() === true && root.child('salons/' + $code + '/joueurs/' + data.val() + '/connecte').val() !== true"
          },
          "duree": {
            ".validate": "newData.val() === 4 || newData.val() === 6 || newData.val() === 8"
          },
          "modeChoix": {
            ".validate": "newData.val() === 'roue' || newData.val() === 'vote'"
          }
        },
        "joueurs": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['prenom', 'nomCode', 'couleur', 'rejointLe', 'connecte']) && (data.exists() || newData.parent().parent().child('deroule/phase').val() === 'salon')",
            "prenom": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
            },
            "connecte": {
              ".validate": "newData.isBoolean()"
            }
          }
        },
        "deroule": {
          ".read": "auth != null"
        },
        "jeu": {
          ".read": "auth != null"
        },
        "scores": {
          ".read": "auth != null"
        },
        "reponses": {
          ".read": "auth != null && root.child('salons/' + $code + '/infos/hote').val() === auth.uid",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && root.child('salons/' + $code + '/joueurs/' + auth.uid).exists()"
          }
        },
        "compteurs": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('salons/' + $code + '/joueurs/' + auth.uid).exists()"
        },
        "tirage": {
          ".read": "auth != null && root.child('salons/' + $code + '/joueurs/' + auth.uid).exists()",
          "prises": {
            "$empreinte": {
              ".write": "auth != null && !data.exists() && root.child('salons/' + $code + '/joueurs/' + auth.uid).exists()",
              ".validate": "newData.val() === true"
            }
          },
          "cibles": {
            "$cible": {
              ".write": "auth != null && root.child('salons/' + $code + '/joueurs/' + auth.uid).exists()",
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2"
            }
          }
        },
        "revelation": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "votes": {
          ".read": "auth != null",
          "$sujet": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('salons/' + $code + '/joueurs/' + auth.uid).exists()"
            }
          }
        },
        "accusations": {
          ".read": "auth != null",
          "$numero": {
            "$accuseur": {
              ".write": "auth != null && auth.uid === $accuseur && !data.exists() && root.child('salons/' + $code + '/joueurs/' + auth.uid).exists()",
              ".validate": "newData.hasChildren(['cible', 'texte', 'le']) && (data.exists() || (!newData.child('reponse').exists() && !newData.child('mission').exists() && !newData.child('statut').exists()))",
              "cible": {
                ".validate": "newData.isString() && newData.val() !== $accuseur && root.child('salons/' + $code + '/joueurs/' + newData.val()).exists()"
              },
              "texte": {
                ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 160"
              },
              "le": {
                ".validate": "newData.isNumber() && newData.val() <= now + 60000"
              },
              "reponse": {
                ".write": "auth != null && !data.exists() && auth.uid === root.child('salons/' + $code + '/accusations/' + $numero + '/' + $accuseur + '/cible').val()",
                ".validate": "newData.val() === 'eu' || newData.val() === 'rate'"
              },
              "mission": {
                ".write": "auth != null && !data.exists() && auth.uid === root.child('salons/' + $code + '/accusations/' + $numero + '/' + $accuseur + '/cible').val()",
                ".validate": "newData.hasChildren(['numero', 'texte', 'difficulte'])"
              }
            }
          }
        },
        "vengeance": {
          "offre": {
            "$uid": {
              ".read": "auth != null && auth.uid === $uid"
            }
          },
          "annonce": {
            "$cible": {
              ".read": "auth != null && auth.uid === $cible",
              ".write": "auth != null && !data.exists() && root.child('salons/' + $code + '/vengeance/offre/' + auth.uid + '/choix/' + $cible).val() === true",
              ".validate": "newData.child('de').val() === auth.uid"
            }
          }
        },
        "paris": {
          ".read": "auth != null && root.child('salons/' + $code + '/infos/hote').val() === auth.uid",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && root.child('salons/' + $code + '/joueurs/' + auth.uid).exists()"
          }
        },
        "motsImposteur": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid"
          }
        },
        "attente": {
          ".read": "auth != null"
        },
        "prive": {
          ".read": "auth != null && root.child('salons/' + $code + '/infos/hote').val() === auth.uid"
        }
      }
    },
    "saisons": {
      "$saison": {
        ".read": "auth != null",
        ".write": "auth != null && $saison.matches(/^[a-z0-9]{12}$/) && (!data.exists() || data.child('infos/createur').val() === auth.uid || data.child('membres/' + auth.uid).exists())",
        "infos": {
          ".validate": "newData.hasChildren(['nom', 'createur', 'creeLe']) && newData.child('nom').isString() && newData.child('nom').val().length <= 30"
        }
      }
    },
    "secrets": {
      "$code": {
        ".write": "auth != null && !newData.exists() && root.child('salons/' + $code + '/infos/hote').val() === auth.uid",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    }
  }
}